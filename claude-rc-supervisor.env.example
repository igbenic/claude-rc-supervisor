# claude-rc-supervisor configuration (bash syntax).
# Copy to ~/.claude-rc-supervisor.env and uncomment what you need
# (install.sh creates the copy automatically if the file does not exist yet).
# After changing it, restart the supervisor:
#   launchctl kickstart -k gui/$(id -u)/com.claude-rc-supervisor

# Folder with repositories (scanned up to 2 levels deep)
#WORK_DIR="$HOME/work"

# How often to rescan for new/removed repositories, seconds
#SCAN_INTERVAL=60

# Path to the claude binary (looked up in PATH by default)
#CLAUDE_BIN="$HOME/.local/bin/claude"

# Automatically mark new repositories as trusted (trust dialog) in ~/.claude.json.
# 0 — disable; then run `claude` manually once in each new repository.
#AUTO_TRUST=1

# Permission mode for remotely created sessions: acceptEdits, auto,
# bypassPermissions, default, dontAsk, plan. Empty = default.
#PERMISSION_MODE=""

# Serve non-git folders (same-dir mode). 0 — git repositories only.
#SERVE_NON_GIT=1

# Folders NOT to serve: space-separated glob patterns relative to WORK_DIR.
#IGNORE_PATTERNS="sandbox/* tmp-* experiments"

# Machine label prepended to session names, so the same repo served from
# two Macs is distinguishable in the app ("mini-grunf-…" vs "mbp-grunf-…").
# Default: short hostname. Empty = repo name only.
#SESSION_PREFIX="mini"

# Log and pid-file directories
#LOG_DIR="$HOME/Library/Logs/claude-rc-supervisor"
#STATE_DIR="$HOME/.local/state/claude-rc-supervisor"
